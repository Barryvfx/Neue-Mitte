generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Supporter {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  email         String   @unique
  city          String?
  message       String?
  notes         String?
  showInTicker  Boolean  @default(false)
  tickerName    String?
  confirmed     Boolean  @default(true)
  confirmToken  String?
  referralToken String?
  createdAt     DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([confirmToken])
  @@map("supporters")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  @@map("admins")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String   @default("")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model NewsArticle {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  category    String    @default("Allgemein")
  published   Boolean   @default(false)
  archived    Boolean   @default(false)
  publishedAt DateTime?
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([published, publishedAt])
  @@map("news_articles")
}

model ContentBlock {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("content_blocks")
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model Event {
  id            String              @id @default(cuid())
  title         String
  description   String
  location      String              @default("")
  date          DateTime
  active        Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  registrations EventRegistration[]

  @@map("events")
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  email     String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId])
  @@map("event_registrations")
}

model Poll {
  id          String       @id @default(cuid())
  question    String
  active      Boolean      @default(true)
  isBarometer Boolean      @default(false)
  createdAt   DateTime     @default(now())
  options     PollOption[]

  @@map("polls")
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  text   String
  votes  Int    @default(0)
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@map("poll_options")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  topics    String   @default("")
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model NewsletterSent {
  id             String   @id @default(cuid())
  subject        String
  previewText    String?
  html           String
  recipientCount Int      @default(0)
  createdAt      DateTime @default(now())

  @@map("newsletter_sent")
}

model PressRelease {
  id        String   @id @default(cuid())
  title     String
  excerpt   String
  fileUrl   String?
  published Boolean  @default(false)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, date])
  @@map("press_releases")
}

model PetitionSignature {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  city      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("petition_signatures")
}

model ReferralLink {
  id          String   @id @default(cuid())
  token       String   @unique
  label       String
  clicks      Int      @default(0)
  conversions Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([token])
  @@map("referral_links")
}

model AbTestClick {
  id        String   @id @default(cuid())
  variant   String
  action    String   @default("cta_click")
  createdAt DateTime @default(now())

  @@index([variant, action])
  @@map("ab_test_clicks")
}

model BuergerFrage {
  id         String   @id @default(cuid())
  question   String
  authorName String
  published  Boolean  @default(false)
  answered   Boolean  @default(false)
  answer     String?
  votes      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([published, votes])
  @@map("buerger_fragen")
}

model Idee {
  id          String   @id @default(cuid())
  title       String
  description String
  authorName  String?
  votes       Int      @default(0)
  status      String   @default("eingereicht")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([published, votes])
  @@map("ideen")
}

model Versprechen {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("gefordert")
  category    String   @default("Allgemein")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@map("versprechen")
}

model WahlTicker {
  id        String           @id @default(cuid())
  title     String
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  items     WahlTickerItem[]

  @@map("wahl_ticker")
}

model WahlTickerItem {
  id        String     @id @default(cuid())
  tickerId  String
  text      String
  important Boolean    @default(false)
  createdAt DateTime   @default(now())
  ticker    WahlTicker @relation(fields: [tickerId], references: [id], onDelete: Cascade)

  @@index([tickerId, createdAt])
  @@map("wahl_ticker_items")
}

model BildungArtikel {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  summary   String
  content   String
  topic     String   @default("Allgemein")
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, topic])
  @@map("bildung_artikel")
}

model SupporterToken {
  id        String   @id @default(cuid())
  token     String   @unique
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([token])
  @@map("supporter_tokens")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("login_attempts")
}

model Debatte {
  id        String       @id @default(cuid())
  title     String
  topic     String       @default("Allgemein")
  status    String       @default("offen")
  createdAt DateTime     @default(now())
  argumente DebatteArg[]

  @@map("debatten")
}

model DebatteArg {
  id        String   @id @default(cuid())
  debatteId String
  text      String
  seite     String
  votes     Int      @default(0)
  createdAt DateTime @default(now())
  debatte   Debatte  @relation(fields: [debatteId], references: [id], onDelete: Cascade)

  @@index([debatteId])
  @@map("debatte_argumente")
}

model Wissenstest {
  id        String   @id @default(cuid())
  question  String
  optionA   String
  optionB   String
  optionC   String
  optionD   String
  correct   String
  category  String   @default("Allgemein")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("wissenstest_fragen")
}

model Faktencheck {
  id        String   @id @default(cuid())
  claim     String
  person    String?
  rating    String   @default("ungeprüft")
  analysis  String
  sources   String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([published])
  @@map("faktenchecks")
}

model GesetzFokus {
  id        String   @id @default(cuid())
  title     String
  lawName   String
  summary   String
  content   String
  link      String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@map("gesetz_fokus")
}

model TransparenzEintrag {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String   @default("Entscheidung")
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([published, createdAt])
  @@map("transparenz_eintraege")
}

model Ehrenamt {
  id          String    @id @default(cuid())
  title       String
  description String
  location    String?
  date        DateTime?
  category    String    @default("Allgemein")
  contact     String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@map("ehrenamt")
}

model Wahlhelfer {
  id        String   @id @default(cuid())
  district  String
  city      String
  state     String   @default("Bayern")
  needed    Int      @default(1)
  filled    Int      @default(0)
  contact   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("wahlhelfer")
}

model MitgliedsContent {
  id        String   @id @default(cuid())
  title     String
  content   String
  type      String   @default("dokument")
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("mitglieds_content")
}

model CivicScore {
  id         String   @id @default(cuid())
  email      String   @unique
  score      Int      @default(0)
  actions    Int      @default(0)
  lastAction String?
  updatedAt  DateTime @updatedAt

  @@index([score])
  @@map("civic_scores")
}
